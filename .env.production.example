# Production values for docker-compose.yml + docker-compose.prod.yml. Copy this file to `.env` on
# the droplet (same directory as docker-compose.yml -- Compose loads it automatically) and fill in
# real values. Never commit the real `.env` (it's gitignored).

# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=

# Generate: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=

NEXT_PUBLIC_SITE_URL=https://myhomeolife.com

# Leave blank until the WhatsApp AI / Calendly features are actually built.
OPENAI_API_KEY=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Stripe (booking payment). Use live keys (sk_live_...) once you've tested with a test-mode key.
# STRIPE_WEBHOOK_SECRET comes from the webhook endpoint you create in the Stripe dashboard pointing
# at https://<your-domain>/api/stripe/webhook -- must be a *live* mode endpoint if STRIPE_SECRET_KEY
# is a live key, they don't mix.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
